# Копия этого файла называется .env и в репозиторий не попадает.

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather.
TELEGRAM_BOT_TOKEN=
# Telegram ID владельца школы: сообщения с этого id идут по ветке владельца.
# Узнать свой id можно у @userinfobot.
OWNER_TELEGRAM_ID=

# Меняется только в тестах, чтобы не ходить в живой Telegram.
# TELEGRAM_API_ROOT=https://api.telegram.org
# Сколько секунд Telegram держит long poll открытым.
# POLL_TIMEOUT_SEC=30

# --- Процесс ----------------------------------------------------------------
# LOG_LEVEL=INFO
# Сколько ждать уже начатые обработчики при остановке.
# SHUTDOWN_DRAIN_SEC=20
# Через сколько секунд простоя убирать воркер чата.
# CHAT_WORKER_IDLE_SEC=300

# --- Школа ------------------------------------------------------------------
# SCHOOL_NAME=Bridge English
# OWNER_HOURS=9:00-21:00 МСК
# Адрес кабинета владельца, появится на этапе 7. Пусто: в карточке заявки будет
# только номер разговора.
# CABINET_URL=

# --- Postgres: Supabase, схема school ---------------------------------------
# Строка роли postgres для scripts/migrate.py и scripts/create_role.py.
# Только на ноутбуке, на VPS не кладём. Берётся из панели Supabase: Connect ->
# Session pooler, порт 5432. Прямое соединение работает только по IPv6.
POSTGRES_URL_NON_POOLING=
# Нужна, только если строка выше смотрит на прямое соединение db.REF.supabase.co:
# тогда сюда строку Session pooler, из неё возьмутся хост и порт для бота.
# POSTGRES_URL_TEMPLATE=
# Строка роли school_bot для бота. Руками не заполняется: её пишет
# scripts/create_role.py вместе с новым паролем.
# POSTGRES_URL=
# SCHOOL_SCHEMA=school
# SCHOOL_DB_ROLE=school_bot

# --- Модель: OpenRouter, GPT-5.6 Luna ---------------------------------------
# Строки ниже активные, без решётки: закомментированную строку бот не читает.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Ключ OpenRouter, начинается с sk-or-.
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna
# none выключает размышление: ответ быстрее, токены размышления не оплачиваются.
LLM_REASONING_EFFORT=none
# Маршрут OpenRouter: только обычный эндпоинт OpenAI (flex медленный, fast
# дорогой), только провайдеры с JSON-схемой и без сбора данных.
LLM_PROVIDER='{"only":["openai"],"ignore":["openai/flex","openai/fast"],"require_parameters":true,"data_collection":"deny"}'
# LLM_TIMEOUT_SEC=45
# LLM_MAX_TOKENS=1200

# Эмбеддинги. Пустые адрес и ключ берутся от модели выше.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
# Меняется только вместе с новой миграцией и полной перезагрузкой базы знаний.
EMBEDDING_DIM=1536
EMBEDDING_PROVIDER='{"data_collection":"deny"}'

# --- Лимиты и бюджет --------------------------------------------------------
# Сообщений от одного клиента в минуту и в сутки. 0 выключает лимит.
# CLIENT_MSGS_PER_MINUTE=20
# CLIENT_MSGS_PER_DAY=200
# Сообщение длиннее этого в модель не идёт.
# CLIENT_MAX_MESSAGE_CHARS=2000
# Токенов модели за скользящие сутки, вход плюс выход. 0 выключает бюджет.
# 2 миллиона это около 500 сообщений с памятью, примерно $0.6 на Luna.
# LLM_DAILY_TOKEN_BUDGET=2000000
# Неверных паролей подряд до блокировки входа в кабинет и на сколько минут.
# CABINET_LOGIN_ATTEMPTS=10
# CABINET_LOGIN_BLOCK_MINUTES=15
# Тело запроса к API больше этого отклоняется до разбора.
# API_MAX_BODY_BYTES=65536

# --- Домен и деплой ---------------------------------------------------------
# Нужно только прод-стеку docker-compose.yml с Caddy. Локальный
# docker-compose.local.yml эти строки не читает, а CABINET_URL переопределяет
# на http://localhost:3000 сам.
# Домен кабинета: Caddy выпишет на него сертификат сам. A-запись должна
# смотреть на IP сервера ДО первого запуска, иначе выпуск не пройдёт.
# Локальная проверка: CABINET_DOMAIN=school.localhost (на IP Caddy слушать не
# будет, он примет адрес за bind-адрес внутри контейнера).
CABINET_DOMAIN=school.example.com
# Адрес кабинета для ссылок в карточках заявок и передач в Telegram.
CABINET_URL=https://school.example.com
# С каких адресов пускать в кабинет, через пробел. Пусто или 0.0.0.0/0 ::/0
# означает «со всех». Домашний IP у провайдеров меняется, с телефона он другой:
# узнать текущий можно на ifconfig.me, дописать сюда и запустить ./deploy.sh.
CABINET_ALLOWED_IPS=
# Если Telegram молчит дольше этого, владельцу уходит алерт один раз.
# POLLER_SILENCE_MINUTES=10

# --- Кабинет владельца ------------------------------------------------------
# Логин и хеш пароля ставит bot/scripts/set_cabinet_password.py, руками не
# заполняются. Пока хеша нет, вход в кабинет отвечает 503.
# CABINET_LOGIN=owner
# CABINET_PASSWORD_HASH=
# CABINET_SESSION_DAYS=7
# Secure-cookie требует https. Для локальной разработки по http поставить false.
# CABINET_COOKIE_SECURE=true

# --- Передача владельцу -----------------------------------------------------
# Через сколько часов молчания владельцу уходит напоминание (один раз).
# HANDOFF_REMINDER_HOURS=2
# Через сколько часов разговор вернётся боту сам, с пометкой «требует внимания».
# HANDOFF_RETURN_HOURS=24
# Как часто фоновая задача проверяет просроченные разговоры.
# JOBS_INTERVAL_SEC=60

# --- Память -----------------------------------------------------------------
# Сколько последних сообщений эпизода уходит модели, остальное живёт в резюме.
# HISTORY_MESSAGES=15
# Через сколько новых сообщений пересобирать резюме о клиенте.
# SUMMARY_EVERY_MESSAGES=10
# SUMMARY_MAX_CHARS=1200
# Переписывать вопрос в самостоятельный запрос перед поиском. false: искать по
# сырому сообщению, на один вызов модели меньше и хуже на «а если 24 занятия?».
# REWRITE_QUERY=true

# --- Поиск по базе знаний ---------------------------------------------------
# SEARCH_TOP_K=8
# Порог косинусной близости. На eval нужные куски не ниже 0.357.
# SEARCH_MIN_SCORE=0.2
# Пусто: папка knowledge/ в корне репозитория.
# KNOWLEDGE_DIR=
